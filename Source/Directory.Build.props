<Project>
  <PropertyGroup>
    <!-- Keep MSBuild intermediates off the exFAT game drive (1 MB clusters waste space on small files). -->
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\ApproachAutopilot\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\ApproachAutopilot\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
